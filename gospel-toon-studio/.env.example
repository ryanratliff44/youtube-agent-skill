# Copy to .env (never commit .env). Paths can be relative to this folder or absolute.

# B-roll (ComfyUI running the WanVideoWrapper nodes, usually on your GPU machine)
# ComfyUI Desktop usually listens on 8000; classic ComfyUI on 8188
COMFYUI_URL=http://127.0.0.1:8000

# TikTok — cookies.txt exported from a browser logged into your TikTok account
TIKTOK_COOKIES=secrets/tiktok_cookies.txt
TIKTOK_HEADLESS=0

# YouTube — OAuth client (Desktop app) from Google Cloud with YouTube Data API v3 enabled
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN=secrets/youtube_token.json

# Instagram — Business/Creator account linked to a Facebook Page (Graph API)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Video editor: if it cannot download its own browser, use your Chrome instead (path to chrome.exe)
# REMOTION_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
